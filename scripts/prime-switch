#!/bin/sh
# prime-switch — install, update, and remove the official Prime Agent build
# and the Prime Agent (drvova build), side by side.
#
# THE COMMANDS: the two builds never share a command, so both answer at
# once and nothing needs switching:
#   official  `prime-agent`  ~/.local/bin/prime-agent (its own installer's
#             prefix ~/.local: bin/prime-agent, share/prime-agent/)
#   fork      `prime`        ~/.local/share/prime-agent-fork/bin/prime
#             (share/prime-agent/, kernel-venv/), plus ~/.local/bin/prime
#             when the fork installer found that slot free (a `prime` it
#             did not write, such as Prime Intellect's own CLI, is never
#             replaced; then the fork's bin dir has to come first on PATH)
#   switch    ~/.local/share/prime-switch/bin   (prime-switch: this script)
#
# Nothing here ever writes inside the official install. Each build's own
# launcher pins its agent dir, daemon socket, and kernel venv (the fork's
# launcher: ~/.prime/agent-fork, prime-agent-fork-<uid>, and
# <fork prefix>/kernel-venv), so the two never share sessions or a live
# daemon. The official build keeps ~/.prime/agent (shared with the
# TypeScript product); the fork keeps its sessions, settings, and logins in
# ~/.prime/agent-fork. The fork's first run copies the official
# configuration over once (settings, auth.json, models.json, keybindings,
# skills, prompts, themes, MCP config, global AGENTS.md/SYSTEM.md) - never
# the sessions. `uninstall fork` leaves ~/.prime/agent-fork in place.
#
# Earlier versions kept a `prime-agent` shim in the switch dir that ran the
# "active" build. Every command retires that shim (marker-checked), so
# `prime-agent` is the official build again.
#
# Usage: prime-switch <command> [--force]
#   status                   both builds' versions, commands, and launchers
#   install fork|official    install a missing build (its own installer)
#   update [fork|official]   update one build, or every installed build
#                            (each through its own `update`)
#   uninstall fork           remove the fork build (official is untouched)
#   --force                  uninstall even while the fork daemon has
#                            sessions mid-turn
#   fork | official          kept for old scripts: says there is nothing
#                            to switch
#
# Environment (tests and custom layouts):
#   PRIME_SWITCH_HOME, PRIME_SWITCH_OFFICIAL_PREFIX, PRIME_SWITCH_FORK_PREFIX,
#   PRIME_SWITCH_FORK_RELEASES_URL, PRIME_SWITCH_OFFICIAL_INSTALLER_URL
set -eu

# Rendered by scripts/release/fork_release.py render (the fork's releases).
FORK_RELEASES_URL_DEFAULT="https://github.com/drvova/prime-agent/releases/latest/download"
OFFICIAL_INSTALLER_URL_DEFAULT="https://app.primeintellect.ai/prime-agent/install.sh"

FORK_RELEASES_URL="${PRIME_SWITCH_FORK_RELEASES_URL:-$FORK_RELEASES_URL_DEFAULT}"
OFFICIAL_INSTALLER_URL="${PRIME_SWITCH_OFFICIAL_INSTALLER_URL:-$OFFICIAL_INSTALLER_URL_DEFAULT}"
OFFICIAL_PREFIX="${PRIME_SWITCH_OFFICIAL_PREFIX:-$HOME/.local}"
FORK_PREFIX="${PRIME_SWITCH_FORK_PREFIX:-$HOME/.local/share/prime-agent-fork}"
SWITCH_HOME="${PRIME_SWITCH_HOME:-$HOME/.local/share/prime-switch}"
SWITCH_BIN="${SWITCH_HOME}/bin"
LEGACY_SHIM="${SWITCH_BIN}/prime-agent"
LEGACY_SHIM_MARK="# prime-agent - active-build shim written by prime-switch"
# The fork installer's public command (install-rust.sh THE DISTRIBUTION
# COMMAND): its second line is this marker, its last line execs the fork
# launcher by absolute path.
FORK_PUBLIC="${HOME}/.local/bin/prime"
FORK_PUBLIC_MARK="# prime - public command written by install-rust.sh"

die() { echo "prime-switch: $1" >&2; exit 1; }
say() { echo "$1"; }
changed() { echo "changed: $1"; }

prefix_of() {
  case "$1" in
    official) printf '%s' "$OFFICIAL_PREFIX" ;;
    fork) printf '%s' "$FORK_PREFIX" ;;
    *) die "unknown build: $1 (fork or official)" ;;
  esac
}
command_of() {
  case "$1" in
    official) printf 'prime-agent' ;;
    fork) printf 'prime' ;;
    *) die "unknown build: $1 (fork or official)" ;;
  esac
}
# The build's launcher. A fork installed before it had its own command
# still has only bin/prime-agent: that launcher answers until its next
# install or update replaces it with bin/prime.
launcher_of() {
  lo_bin="$(prefix_of "$1")/bin"
  if [ "$1" = fork ] && [ ! -x "${lo_bin}/prime" ] && [ -x "${lo_bin}/prime-agent" ]; then
    printf '%s/prime-agent' "$lo_bin"
  else
    printf '%s/%s' "$lo_bin" "$(command_of "$1")"
  fi
}
# A build is installed when its installer's ownership marker and launcher exist.
is_installed() {
  [ -x "$(launcher_of "$1")" ] \
    && [ -f "$(prefix_of "$1")/share/prime-agent/.prime-agent-install" ]
}
version_of() {
  sed -n '2s/^version //p' "$(prefix_of "$1")/share/prime-agent/.prime-agent-install" 2>/dev/null
}
# True when the fork's public command is the fork installer's own file
# pointing into the fork prefix named by $1 (its physical path).
fork_public_is_ours() {
  [ -f "$FORK_PUBLIC" ] && [ ! -L "$FORK_PUBLIC" ] \
    && [ "$(sed -n 2p "$FORK_PUBLIC" 2>/dev/null)" = "$FORK_PUBLIC_MARK" ] \
    && grep -qF "exec '$1/bin/" "$FORK_PUBLIC" 2>/dev/null
}

# The pre-`prime` shim goes: only the file this script wrote (its marker).
retire_legacy_shim() {
  if [ -f "$LEGACY_SHIM" ] && grep -qxF "$LEGACY_SHIM_MARK" "$LEGACY_SHIM" 2>/dev/null; then
    rm -f "$LEGACY_SHIM"
    changed "removed the old ${LEGACY_SHIM} shim (\`prime-agent\` runs the official build again; the fork is \`prime\`)"
  fi
}

# The busy check and the clean stop, through the build's OWN launcher (its
# socket pin): `list --json` answers only while that build's daemon runs;
# `shutdown --force` is the CLI's scripted, non-interactive stop.
stop_daemon_of() {
  sd_build="$1"; sd_force="$2"
  sd_launcher="$(launcher_of "$sd_build")"
  is_installed "$sd_build" || return 0
  if ! sd_sessions="$("$sd_launcher" list --json 2>/dev/null)"; then
    say "no ${sd_build} daemon is running"
    return 0
  fi
  if printf '%s' "$sd_sessions" | grep -Eq '"isStreaming"[[:space:]]*:[[:space:]]*true|"activity"[[:space:]]*:[[:space:]]*"working"'; then
    [ "$sd_force" = 1 ] || die "the ${sd_build} daemon has sessions mid-turn; let them finish (${sd_launcher} list) or re-run with --force"
    say "--force: stopping the ${sd_build} daemon although sessions are mid-turn"
  fi
  "$sd_launcher" shutdown --force --json >/dev/null 2>&1 \
    || die "the ${sd_build} daemon did not stop (${sd_launcher} shutdown --force); stop it by hand and re-run"
  changed "stopped the ${sd_build} daemon (${sd_launcher} shutdown --force)"
}

# Which `prime-agent` and `prime` a shell runs, and whether that is the build
# the name belongs to.
path_hint() {
  for ph_build in official fork; do
    ph_command="$(command_of "$ph_build")"
    ph_resolved="$(command -v "$ph_command" 2>/dev/null || true)"
    if [ -z "$ph_resolved" ]; then
      is_installed "$ph_build" && say "note: \`${ph_command}\` is not on PATH; add $(dirname "$(launcher_of "$ph_build")") (or run $(launcher_of "$ph_build"))"
      continue
    fi
    if [ "$ph_resolved" -ef "$(launcher_of "$ph_build")" ]; then
      continue
    fi
    if [ "$ph_build" = fork ] && [ "$ph_resolved" -ef "$FORK_PUBLIC" ] && [ -d "$FORK_PREFIX" ] \
       && fork_public_is_ours "$(cd "$FORK_PREFIX" && pwd -P)"; then
      continue
    fi
    is_installed "$ph_build" || continue
    say "note: \`${ph_command}\` on PATH is ${ph_resolved}, not the ${ph_build} build."
    say "  put $(dirname "$(launcher_of "$ph_build")") first on PATH, or run $(launcher_of "$ph_build")"
  done
}

# The leftover shared-state hazard: a models.json provider that
# authenticates by token exchange (a fork feature) has no apiKey, and the
# official build's models.json validation rejects the whole file — every
# custom model drops out there until the entry is removed. The fork keeps
# its own models.json now, so only an entry added to the official
# ~/.prime/agent/models.json (by hand, or by a fork from before it had its
# own agent dir) still trips it. auth.json is safe: the official build
# skips the token_exchange entries it cannot parse and keeps them.
models_warning() {
  mw_models="${PRIME_AGENT_CODING_AGENT_DIR:-$HOME/.prime/agent}/models.json"
  if [ -f "$mw_models" ] && grep -q 'token-exchange' "$mw_models" 2>/dev/null; then
    say "warning: ${mw_models} declares a token-exchange provider (a fork-only auth block);"
    say "  the official build rejects that models.json, so its custom models will not load."
  fi
}

# Copy this script into the switch dir (the one-liner runs it from a pipe:
# then the fork releases' own copy is downloaded).
ensure_self() {
  mkdir -p "$SWITCH_BIN"
  es_dest="${SWITCH_BIN}/prime-switch"
  es_tmp="$(mktemp "${SWITCH_BIN}/.prime-switch.XXXXXX")"
  if [ -f "$0" ] && grep -q '^# prime-switch' "$0" 2>/dev/null; then
    cp "$0" "$es_tmp"
  else
    curl -fsSL "${FORK_RELEASES_URL}/prime-switch" -o "$es_tmp" \
      || { rm -f "$es_tmp"; die "could not download ${FORK_RELEASES_URL}/prime-switch"; }
  fi
  chmod 0755 "$es_tmp"
  if [ -f "$es_dest" ] && cmp -s "$es_tmp" "$es_dest"; then
    rm -f "$es_tmp"
  else
    mv -f "$es_tmp" "$es_dest"
    changed "installed ${es_dest}"
  fi
}

run_installer() {
  ri_build="$1"
  case "$ri_build" in
    official) ri_url="$OFFICIAL_INSTALLER_URL" ;;
    fork) ri_url="${FORK_RELEASES_URL}/install.sh" ;;
    *) die "unknown build: $ri_build (fork or official)" ;;
  esac
  ri_scratch="$(mktemp -d "${TMPDIR:-/tmp}/prime-switch.XXXXXX")"
  curl -fsSL "$ri_url" -o "${ri_scratch}/install.sh" \
    || { rm -rf "$ri_scratch"; die "could not download the ${ri_build} installer from ${ri_url}"; }
  say "running the ${ri_build} installer from ${ri_url} (prefix $(prefix_of "$ri_build"))"
  # The other build's knobs must not leak in: each installer reads only
  # its own rendered defaults plus the prefix named here.
  ri_status=0
  (
    unset PRIME_AGENT_DOWNLOAD_BASE_URL PRIME_AGENT_RELEASE_ASSETS_URL \
      PRIME_AGENT_VERSION PRIME_AGENT_DAEMON_SOCKET PRIME_AGENT_KERNEL_VENV
    PRIME_AGENT_RUST_PREFIX="$(prefix_of "$ri_build")"
    export PRIME_AGENT_RUST_PREFIX
    sh "${ri_scratch}/install.sh"
  ) || ri_status=$?
  rm -rf "$ri_scratch"
  [ "$ri_status" -eq 0 ] || die "the ${ri_build} installer failed (exit ${ri_status})"
}

cmd_status() {
  for build in official fork; do
    if is_installed "$build"; then
      say "$(printf '%-9s' "${build}:") $(version_of "$build")  $(command_of "$build")  $(launcher_of "$build")"
    else
      say "$(printf '%-9s' "${build}:") not installed  (prime-switch install ${build})"
    fi
  done
  if [ -e "$FORK_PUBLIC" ] && is_installed fork; then
    if fork_public_is_ours "$(cd "$FORK_PREFIX" && pwd -P)"; then
      say "public:   ${FORK_PUBLIC} runs the fork build"
    else
      say "public:   ${FORK_PUBLIC} is not the fork's (another \`prime\`, left untouched)"
    fi
  fi
  path_hint
}

cmd_install() {
  build="$1"
  ensure_self
  if is_installed "$build"; then
    say "unchanged: the ${build} build is already installed ($(version_of "$build")); prime-switch update ${build} updates it"
    return 0
  fi
  prefix_of "$build" >/dev/null
  run_installer "$build"
  is_installed "$build" || die "the ${build} installer finished but $(launcher_of "$build") is missing"
  changed "installed the ${build} build $(version_of "$build") at $(prefix_of "$build")"
  say "run \`$(command_of "$build")\` to start the ${build} build"
  [ "$build" = official ] && models_warning
  path_hint
}

cmd_update() {
  update_target="$1"
  update_status=0
  updated=""
  for build in official fork; do
    [ -z "$update_target" ] || [ "$update_target" = "$build" ] || continue
    if ! is_installed "$build"; then
      [ -z "$update_target" ] || die "the ${build} build is not installed: run prime-switch install ${build}"
      continue
    fi
    say "updating the ${build} build: $(launcher_of "$build") update"
    "$(launcher_of "$build")" update || update_status=$?
    updated="yes"
  done
  [ -n "$updated" ] || die "no build is installed: run prime-switch install fork|official"
  [ "$update_status" -eq 0 ] || die "an update failed (exit ${update_status})"
}

cmd_uninstall() {
  build="$1"; force="$2"
  [ "$build" = fork ] || die "only the fork build is uninstalled here; the official build keeps its own installer's layout"
  if ! is_installed fork; then
    say "unchanged: the fork build is not installed"
    return 0
  fi
  # The removal guard: only a marked fork prefix that is neither $HOME, the
  # official prefix, nor one of their ancestors is ever removed.
  fork_real="$(cd "$FORK_PREFIX" && pwd -P)"
  official_real="$(cd "$OFFICIAL_PREFIX" 2>/dev/null && pwd -P || printf '%s' "$OFFICIAL_PREFIX")"
  home_real="$(cd "$HOME" && pwd -P)"
  for protected in "$official_real" "$home_real" /; do
    case "${protected}/" in
      "${fork_real}/"*) die "refusing to remove ${fork_real}: it contains ${protected}" ;;
    esac
  done
  grep -q '^install-rust.sh channel ' "${fork_real}/share/prime-agent/.prime-agent-install" \
    || die "refusing to remove ${fork_real}: it carries no installer marker"
  stop_daemon_of fork "$force"
  # The fork's public command is part of the fork install: it goes only when
  # it is the fork installer's own file AND runs this fork prefix. Any other
  # ~/.local/bin/prime (Prime Intellect's CLI) stays exactly as it is.
  if fork_public_is_ours "$fork_real"; then
    rm -f "$FORK_PUBLIC"
    changed "removed ${FORK_PUBLIC}"
  fi
  rm -rf -- "$fork_real"
  changed "removed the fork build at ${fork_real}"
}

command="${1:-status}"
[ $# -gt 0 ] && shift
force=0
target=""
for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    fork|official) [ -z "$target" ] || die "one build at a time"; target="$arg" ;;
    *) die "unknown argument: $arg" ;;
  esac
done
case "$command" in
  -h|--help|help) sed -n '2,39p' "$0" 2>/dev/null || echo "prime-switch status|install|update|uninstall"; exit 0 ;;
  status|fork|official|install|update|uninstall) retire_legacy_shim ;;
  *) die "unknown command: ${command} (status, install, update, uninstall)" ;;
esac
case "$command" in
  status) cmd_status ;;
  fork|official)
    say "nothing to switch: the fork build is \`prime\` and the official build is \`prime-agent\`;"
    say "  both answer at once (prime-switch status shows where each one lives)"
    ;;
  install) [ -n "$target" ] || die "usage: prime-switch install fork|official"; cmd_install "$target" ;;
  update) cmd_update "$target" ;;
  uninstall) [ -n "$target" ] || die "usage: prime-switch uninstall fork"; cmd_uninstall "$target" "$force" ;;
  *) die "unknown command: ${command}" ;;
esac
